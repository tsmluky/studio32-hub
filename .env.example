VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_URL=https://www.hub.studio32.es

# Solo para ejecutar scripts/bootstrap-supabase.mjs. Nunca se publica.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Solo para `npm run supabase:migrate`. Nunca se publica.
# Panel de Supabase -> Project Settings -> Database -> Connection string.
# Usa "Session pooler" o la conexión directa (puerto 5432). La de 6543 es modo
# transacción y no lleva bien las sentencias DDL de las migraciones.
SUPABASE_DB_URL=postgresql://postgres.your-ref:your-password@your-host:5432/postgres

# Estos NO van en el .env: van en Supabase -> Edge Functions -> Secrets, porque
# quien envia es la funcion outreach-send, no esta maquina.
#
#   SMTP_HOST   smtp.hostinger.com
#   SMTP_PORT   465
#   SMTP_USER   info@studio32.es      <- la cuenta real, no un alias
#   SMTP_PASS   la contrasena de esa cuenta
#   OUTREACH_FROM   Studio32 <info@studio32.es>
#
# Y uno opcional. Si se pone, TIENE que ser una URL http(s) completa; cualquier
# otra cosa se ignora y el pie del correo pide responder BAJA. Se aprendio por las
# malas: quedo puesto a la palabra "opcional" y los correos salieron con un pie que
# decia "opcional?t=<token>".
#
#   OUTREACH_UNSUBSCRIBE_BASE   https://studio32.es/baja
