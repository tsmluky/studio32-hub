VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_URL=https://www.hub.studio32.es

# Solo para ejecutar scripts/bootstrap-supabase.mjs. Nunca se publica.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Solo para `npm run supabase:migrate`. Nunca se publica.
# Panel de Supabase -> Project Settings -> Database -> Connection string.
# Usa "Session pooler" o la conexión directa (puerto 5432). La de 6543 es modo
# transacción y no lleva bien las sentencias DDL de las migraciones.
SUPABASE_DB_URL=postgresql://postgres.your-ref:your-password@your-host:5432/postgres

# Solo para `npm run leads:enviar`. Nunca se publica, y NUNCA sale de tu maquina:
# ni a Supabase, ni al bundle del hub, ni a Railway.
#
# Son App Passwords de Gmail (Cuenta de Google -> Seguridad -> Verificacion en dos
# pasos -> Contrasenas de aplicaciones), no la contrasena normal de la cuenta.
#
# Cada uno pone SOLO la suya. Quien ejecuta el script unicamente puede enviar en
# nombre de aquellos cuyas credenciales tenga: los demas leads quedan aprobados
# esperando a que los envie su remitente.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_JUANMA_USER=juanma@studio32.es
SMTP_JUANMA_PASS=app-password-de-juanma
SMTP_PANCHO_USER=pancho@studio32.es
SMTP_PANCHO_PASS=app-password-de-pancho
SMTP_GONZALO_USER=gonzalo@studio32.es
SMTP_GONZALO_PASS=app-password-de-gonzalo
